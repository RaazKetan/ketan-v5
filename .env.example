# =========================================================================
# Server-only secrets (set in Vercel project settings).
# These are NEVER exposed to the client. Anything with a VITE_ prefix is
# inlined into the client bundle by Vite — keep prefixes off these names.
# =========================================================================

# --- Sarvam (TTS + STT + RAG LLM generation) ----------------------------
SARVAM_API_KEY=

# --- Google Gemini (RAG embeddings: text-embedding-004) -----------------
GEMINI_API_KEY=

# --- Supabase (conversation log) ----------------------------------------
# Auto-injected by the Vercel Marketplace Supabase integration.
# SERVICE_ROLE_KEY MUST stay server-only — bypasses Row-Level Security.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (gates /admin + /api/admin/*) --------------------------------
# Single allow-listed Google email. Anyone else who signs in with Google
# gets a clean 403. Compare is case-insensitive.
ADMIN_EMAIL=

# HMAC signing secret for the admin session cookie. The cookie value is
#   <email>.<expiry_ms>.<HMAC-SHA256(email + "." + expiry, secret)>
# Rotate this to revoke every active admin session in one go.
# Generate with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Legacy alias for ADMIN_SESSION_SECRET. Old deploys can keep this and
# everything still works; remove once you've rotated to the new name.
# ADMIN_TOKEN=

# --- Supabase client (browser) ------------------------------------------
# VITE_ prefix is REQUIRED for client-side access. These are inlined into
# the JS bundle by Vite. The anon/publishable key is safe to expose;
# never put service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# =========================================================================
# Origin / deployment config — single source of truth lives here, NOT in
# code. The proxy reads these to decide which browsers are allowed to
# call /api/* endpoints.
# =========================================================================

# Comma-separated list of canonical hostnames allowed to call /api/*.
# Required in production. Example:
#   ALLOWED_ORIGINS=https://ketanraj.com,https://www.ketanraj.com,https://ketan-v5-ketan-rajs-projects.vercel.app
ALLOWED_ORIGINS=

# Dev-only origin allow-list. Layered in only when NODE_ENV !== 'production'.
# Falls back to common Vite/Next localhost ports if unset.
# Example:
#   ALLOWED_DEV_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_DEV_ORIGINS=

# Regex (source only, no slashes/flags) matching Vercel preview deploy
# hosts so PR previews can call /api/* without per-deploy env updates.
# Leave empty to disable preview-host matching entirely.
# Example for the ketan-v5 project:
#   PREVIEW_ORIGIN_PATTERN=^https:\/\/ketan-v5-[a-z0-9-]+-ketan-rajs-projects\.vercel\.app$
PREVIEW_ORIGIN_PATTERN=
