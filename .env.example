# Server-only secrets (set in Vercel project settings).
# These are NEVER exposed to the client.

# Sarvam AI key for TTS/STT + the RAG agent's LLM generation —
# proxied through api/sarvam/* edge functions.
SARVAM_API_KEY=

# Google Gemini key for the RAG agent's semantic embeddings
# (text-embedding-004) — proxied through api/embed.ts.
GEMINI_API_KEY=

# Supabase — provisioned via Vercel Marketplace → Supabase Integration.
# The integration auto-injects all three into the project env. List them
# here for local dev (.env.local). The SERVICE_ROLE key MUST stay
# server-only and is never read from the client bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Single-secret bearer token that gates /admin and /api/admin/*.
# Set via `vercel env add ADMIN_TOKEN production` (generate with
# `openssl rand -base64 48`). Constant-time-compared on every admin
# request, so a typo never reveals length info.
ADMIN_TOKEN=

# Daily-rotating salt used by api/_shared/identity.ts to hash IPs.
# Any random secret string works; rotating it invalidates prior-day
# hash correlations.
IP_HASH_SALT=

# Optional comma-separated origin allow-list for the proxy.
# Defaults to the production Vercel domains + localhost in dev.
# Example: https://ketan-v5.vercel.app,https://ketanraj.com
ALLOWED_ORIGINS=
